<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#061b3a;
    color:#fff;
    line-height:1.6;
}

a{
    text-decoration:none;
    color:inherit;
}

.container{
    width:90%;
    max-width:1150px;
    margin:auto;
}

/* HEADER */
header{
    position:sticky;
    top:0;
    z-index:1000;
    background:#071b38;
    border-bottom:1px solid rgba(255,255,255,.12);
}

.navbar{
    min-height:78px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    font-size:20px;
    font-weight:800;
}

.logo-box{
    width:48px;
    height:48px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,#20c9ff,#2878ff);
    font-size:25px;
    font-weight:900;
}

nav{
    display:flex;
    gap:25px;
    align-items:center;
}

nav a{
    color:#d9e7ff;
    font-weight:600;
}

nav a:hover{
    color:#28d5ff;
}

.menu-btn{
    display:none;
    font-size:30px;
    cursor:pointer;
}

/* HERO */
.hero{
    min-height:calc(100vh - 78px);
    display:flex;
    align-items:center;
    background:
    radial-gradient(circle at 80% 20%,rgba(21,194,255,.22),transparent 35%),
    linear-gradient(135deg,#061735,#092f65);
    padding:70px 0;
}

.hero-content{
    max-width:850px;
}

.badge{
    display:inline-block;
    padding:12px 20px;
    border:1px solid rgba(255,255,255,.25);
    border-radius:30px;
    background:rgba(255,255,255,.09);
    color:#dff8ff;
    margin-bottom:25px;
    font-weight:700;
}

.hero h1{
    font-size:clamp(45px,8vw,82px);
    line-height:1.02;
    margin-bottom:25px;
}

.hero h1 span{
    color:#29d2ff;
}

.hero p{
    color:#d5e4f7;
    font-size:20px;
    max-width:760px;
    margin-bottom:35px;
}

.buttons{
    display:flex;
    flex-wrap:wrap;
    gap:15px;
}

.btn{
    display:inline-flex;
    justify-content:center;
    align-items:center;
    padding:16px 27px;
    border-radius:15px;
    font-weight:800;
    transition:.3s;
}

.btn-primary{
    background:#28c9f5;
    color:#03152d;
}

.btn-secondary{
    border:1px solid rgba(255,255,255,.35);
    background:rgba(255,255,255,.05);
}

.btn:hover{
    transform:translateY(-3px);
}

/* SECTIONS */
section{
    padding:85px 0;
}

.section-title{
    text-align:center;
    margin-bottom:50px;
}

.section-title h2{
    font-size:42px;
    margin-bottom:12px;
}

.section-title span{
    color:#29d2ff;
}

.section-title p{
    color:#afc5df;
}

/* CARDS */
.cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.card{
    padding:28px;
    border-radius:22px;
    background:linear-gradient(145deg,#0c315d,#09264c);
    border:1px solid rgba(255,255,255,.1);
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
    border-color:#26cdf9;
}

.icon{
    font-size:40px;
    margin-bottom:15px;
}

.card h3{
    margin-bottom:10px;
    font-size:21px;
}

.card p{
    color:#b9cce2;
}

/* ABOUT */
.about{
    background:#071f43;
}

.about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:45px;
    align-items:center;
}

.about-box{
    padding:35px;
    border-radius:25px;
    background:linear-gradient(145deg,#103967,#08274e);
    border:1px solid rgba(255,255,255,.1);
}

.about-box h3{
    font-size:30px;
    margin-bottom:18px;
}

.about-box p{
    color:#c1d2e7;
    margin-bottom:20px;
}

.check{
    margin:12px 0;
    color:#dcecff;
}

.check span{
    color:#29d2ff;
    font-weight:bold;
}

/* CTA */
.cta{
    text-align:center;
    background:
    radial-gradient(circle at center,rgba(34,207,255,.2),transparent 50%),
    #082653;
}

.cta h2{
    font-size:45px;
    margin-bottom:15px;
}

.cta p{
    color:#c5d7eb;
    max-width:700px;
    margin:0 auto 30px;
}

/* CONTACT */
.contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px;
}

.contact-card{
    padding:30px;
    border-radius:22px;
    background:#0a2850;
    border:1px solid rgba(255,255,255,.1);
}

.contact-card h3{
    margin-bottom:15px;
}

.contact-card p{
    color:#c4d5e8;
    margin:8px 0;
}

/* FOOTER */
footer{
    padding:35px 0;
    background:#04142c;
    text-align:center;
    color:#9db4d0;
}

footer strong{
    color:white;
}

/* WHATSAPP */
.whatsapp{
    position:fixed;
    right:20px;
    bottom:20px;
    z-index:999;
    width:58px;
    height:58px;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#25D366;
    color:white;
    font-size:28px;
    box-shadow:0 8px 25px rgba(0,0,0,.35);
}

/* RESPONSIVE */
@media(max-width:850px){

    nav{
        display:none;
        position:absolute;
        top:78px;
        left:0;
        width:100%;
        background:#071b38;
        padding:25px;
        flex-direction:column;
        border-bottom:1px solid rgba(255,255,255,.1);
    }

    nav.active{
        display:flex;
    }

    .menu-btn{
        display:block;
    }

    .cards{
        grid-template-columns:1fr 1fr;
    }

    .about-grid,
    .contact-grid{
        grid-template-columns:1fr;
    }
}

@media(max-width:550px){

    .navbar{
        min-height:70px;
    }

    .logo{
        font-size:16px;
    }

    .logo-box{
        width:43px;
        height:43px;
    }

    .hero{
        padding:55px 0;
    }

    .hero h1{
        font-size:48px;
    }

    .hero p{
        font-size:17px;
    }

    .buttons{
        flex-direction:column;
    }

    .btn{
        width:100%;
    }

    section{
        padding:65px 0;
    }

    .section-title h2{
        font-size:34px;
    }

    .cards{
        grid-template-columns:1fr;
    }

    .cta h2{
        font-size:34px;
    }
}
</style>
</head>

